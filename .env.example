# Trap Tracker Offline Processor example environment file
# Copy this file to .env if you want to customise local settings.

APP_PORT=8501
MODEL_DIR=/app/models
INPUT_DIR=/app/input
OUTPUT_DIR=/app/output
RUNS_DIR=/app/runs
LOG_DIR=/app/logs
ORT_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
MAX_CONTENT_LENGTH_MB=4096

# Optional. Set a stable long random value for production/internal deployments.
# SECRET_KEY=change-me-to-a-long-random-value
